{
  "name": "betterslack",
  "version": "3.7.0",
  "private": false,
  "description": "Themes, plugins and mods for the Slack desktop app",
  "type": "module",
  "bin": {
    "betterslack": "./bin/betterslack.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm validate-mods && pnpm registry && pnpm site && pnpm test:core && pnpm test && pnpm check-structure",
    "dev": "node scripts/build.mjs --watch",
    "start": "node bin/betterslack.mjs",
    "registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit",
    "validate-mods": "node scripts/validate-mods.mjs",
    "test": "node scripts/test-mods.mjs",
    "check-structure": "node scripts/check-structure.mjs",
    "test:core": "node scripts/test-core.mjs",
    "new-mod": "node scripts/new-mod.mjs",
    "release": "node scripts/release.mjs",
    "test:live": "node scripts/test-live.mjs",
    "site": "node scripts/build-site.mjs",
    "site:dev": "node scripts/site-dev.mjs",
    "shoot": "node scripts/shoot.mjs",
    "icon": "node scripts/build-icon.mjs",
    "build:disclaim": "node scripts/build-disclaim.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": "Erwan Martin",
  "packageManager": "pnpm@11.5.2"
}
